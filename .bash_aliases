### Common Commands
alias ls="ls -p --color=auto"
alias lrt="ls -lrt"
alias ll="ls -ll"
alias g="grep -rnI --color=auto"
alias cls="clear"
alias md="mkdir -p"
alias rmdir="rm -rf"
alias cp='cp -i'
alias mv='mv -i'
alias rm='rm -I'
alias ln='ln -i'

### Move up directories
alias .1="cd ../"
alias .2="cd ../../"
alias .3="cd ../../../"
alias .4="cd ../../../../"
alias .5="cd ../../../../../"
alias .6="cd ../../../../../../"
alias .7="cd ../../../../../../../"
alias .8="cd ../../../../../../../../"
alias .9="cd ../../../../../../../../../"

### Python
alias python="python3.11"
alias python2="python2.7"

### Windows
alias winUser="cd /mnt/c/Users/mickj/"
